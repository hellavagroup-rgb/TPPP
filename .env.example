# Copy this file to .env for local development outside of Replit.
# On Replit, set these in the Secrets tab (padlock icon) — never in a .env file.

# PostgreSQL connection (auto-provided by Replit's database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session encryption key — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-long-random-secret-here

# Resend API key for transactional emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender address shown on outgoing emails
FROM_EMAIL=Your Practice <noreply@yourdomain.com>
